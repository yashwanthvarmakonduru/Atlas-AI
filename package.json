{
  "name": "atlas-ai",
  "private": true,
  "type": "module",
  "description": "A private knowledge copilot: upload your documents, ask questions, and get streamed answers with citations you can check.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,yellow,magenta \"npm run dev -w @atlas/api\" \"npm run dev -w @atlas/worker\" \"npm run dev -w @atlas/web\"",
    "build": "npm run build -w @atlas/api && npm run build -w @atlas/worker && npm run build -w @atlas/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -w @atlas/shared -w @atlas/core -w @atlas/api -w @atlas/web -w @atlas/eval",
    "test:coverage": "npm run test:coverage -w @atlas/core -w @atlas/api",
    "eval": "npm run check -w @atlas/eval",
    "seed": "npm run seed -w @atlas/eval",
    "explain": "npm run explain -w @atlas/eval",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0"
  }
}
