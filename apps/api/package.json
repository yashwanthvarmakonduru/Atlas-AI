{
  "name": "@atlas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express API: accounts, sessions and workspaces.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@atlas/core": "*",
    "@atlas/shared": "*",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jose": "^6.0.0",
    "mongodb": "^7.0.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.3"
  }
}
