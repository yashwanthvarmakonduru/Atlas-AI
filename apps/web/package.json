{
  "name": "@atlas/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js app for Atlas AI, built with the Meridian design system.",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "dependencies": {
    "@atlas/shared": "*",
    "@tanstack/react-query": "^5.90.0",
    "@yashwanthvarma74/react": "^0.2.0",
    "@yashwanthvarma74/tokens": "^0.2.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.10.0",
    "jsdom": "^31.0.0",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "size-limit": [
    {
      "name": "JavaScript the browser downloads (gzip)",
      "path": ".next/static/chunks/**/*.js",
      "limit": "400 kB",
      "gzip": true
    }
  ]
}
