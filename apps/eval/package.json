{
  "name": "@atlas/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The evaluation harness: a labelled benchmark, the run that scores retrieval and citations, and the gate that compares runs.",
  "scripts": {
    "generate": "tsx src/generate.ts",
    "run": "tsx --env-file-if-exists=../../.env src/cli.ts run",
    "check": "tsx --env-file-if-exists=../../.env src/cli.ts check",
    "sweep": "tsx --env-file-if-exists=../../.env src/cli.ts sweep",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "explain": "tsx --env-file-if-exists=../../.env src/explain.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "remote": "tsx src/remote.ts"
  },
  "dependencies": {
    "@atlas/core": "*",
    "@atlas/shared": "*",
    "mongodb": "^7.0.0",
    "pino": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.20.0",
    "vitest": "^5.0.3"
  }
}
